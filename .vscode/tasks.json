{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run Firestore Emulator",
      "type": "shell",
      "command": "firebase emulators:start --project kd-portfolio-prod --import ./.firebase/data --export-on-exit",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Run API",
      "type": "shell",
      "command": "./mvnw.cmd spring-boot:run",
      "options": {
        "cwd": "${workspaceFolder}/api",
        "env": {
          "FIRESTORE_EMULATOR_HOST": "127.0.0.1:8081",
          "FIREBASE_AUTH_EMULATOR_HOST": "127.0.0.1:9099",
          "GOOGLE_CLOUD_PROJECT": "kd-portfolio-prod",
          "SPRING_PROFILES_ACTIVE": "local"
        }
      },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Run Web",
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}/web"
      },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Run All (Emulator + API + Web)",
      "dependsOrder": "parallel",
      "dependsOn": ["Run Firestore Emulator", "Run API", "Run Web"],
      "problemMatcher": []
    }
  ]
}
