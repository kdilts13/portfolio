# EditorConfig helps maintain consistent coding styles across editors and IDEs
# https://editorconfig.org

root = true

# ========================================
# Default settings for all files
# ========================================
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# ========================================
# Java / Spring Boot code style
# ========================================
[*.{java,xml,properties}]
indent_size = 4
continuation_indent_size = 8
max_line_length = 120

# ========================================
# JSON / YAML / Markdown
# ========================================
[*.{json,yml,yaml,md}]
indent_size = 2

# ========================================
# HTML / CSS / JS / TS / JSX / TSX
# ========================================
[*.{js,ts,jsx,tsx,html,css,scss}]
indent_size = 2

# ========================================
# Gradle / Maven files
# ========================================
[*.{gradle,pom,xml}]
indent_size = 4

# ========================================
# Misc
# ========================================
[Makefile]
indent_style = tab